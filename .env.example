# API environments offered in the "Try it" explorer.
# Do NOT put an API key here: VITE_* values are bundled into the public JS.
VITE_API_PRODUCTION_URL=https://api.flowpos.co.uk/v1
VITE_API_STAGING_URL=https://api.flowpos.dev/v1

# Environment selected by default for new visitors: production | staging
VITE_API_DEFAULT_ENV=production
